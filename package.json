{
  "name": "book-of-life-beyond-the-pages",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic academic storybook experience",
  "type": "module",
  "scripts": {
    "dev": "python tools/serve.py",
    "start": "npm run dev",
    "preview": "npm run dev",
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:python && npm run lint:format",
    "lint:js": "eslint --config tools/lint/eslint.mjs \"dist/js/**/*.js\" \"tools/**/*.mjs\"",
    "lint:css": "biome lint --config-path=tools/lint/biome.json --error-on-warnings dist/css dist/assets/fonts/fonts.css",
    "lint:html": "node tools/lint/html.mjs",
    "lint:python": "python -m ruff check --no-cache --select E4,E7,E9,F,I tools && python -m ruff format --check --no-cache tools",
    "lint:format": "prettier --config tools/lint/prettier.json --check \"dist/index.html\" \"dist/css/*.css\" \"dist/js/**/*.js\" \"tools/**/*.mjs\" \"tools/lint/*.json\" \"dist/assets/project-info.json\" \".openai/hosting.json\" \"asset-manifest.json\" \"package.json\"",
    "test": "python tools/test.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "prettier": "3.10.1"
  }
}
